# Демонстрация графиков в консоли

# График квадратичной функции
print "Рисуем параболу y = x^2"
plot("x^2", -3, 3, 50, 15, "*")

# График синуса
print "Синусоида"
plot("sin(x)", -6.28318, 6.28318, 60, 12, "#")

# Точечная диаграмма
x_vals = [-2, -1, 0, 1, 2]
y_vals = [4, 1, 0, 1, 4]
scatter(x_vals, y_vals, 40, 10, "@")

# Информация об осях
axis()
grid()
